# Copy to .env.local (repo root) and fill in. Never commit real values.

APP_MODE=demo                      # demo | live

# Supabase Postgres (direct or session-pooler connection; postgresql:// is fine)
DATABASE_URL=

SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vigia

# Vercel Cron -> GET /api/jobs/scan with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Live mode only (APP_MODE=live): Copernicus Data Space OAuth client + NASA FIRMS key
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
FIRMS_MAP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_SECRET=
# Optional (defaults in code): base URL for /a/{id} links; confidence (0..1) at which a scan alerts by itself
# PUBLIC_APP_URL=http://localhost:3000
# CRITICAL_CONFIDENCE_THRESHOLD=0.75
LLM_API_KEY=
LLM_MODEL=

# Frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
