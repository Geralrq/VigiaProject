{
  "services": {
    "web": { "root": "frontend", "framework": "nextjs" },
    "api": { "root": "backend", "framework": "fastapi", "entrypoint": "main:app" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/jobs/scan", "schedule": "0 11 * * *" }]
}
